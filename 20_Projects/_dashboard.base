filters:
  and:
    - file.inFolder("20_Projects")
    - file.ext == "md"
    - '!file.name.startsWith("_")'
    - project_id
    - file.basename == project_id
formulas:
  updated: file.mtime.relative()
  days_since_update: (now() - file.mtime).days.floor()
  status_icon: if(status == "active", "🟢", if(status == "completed", "✅", if(status == "on-hold", "⏸️", "📋")))
  is_stale: status == "active" && (now() - file.mtime).days.floor() >= 14
properties:
  file.name:
    displayName: 노트
  project_id:
    displayName: 프로젝트 ID
  status:
    displayName: 상태
  formula.updated:
    displayName: 수정
  formula.days_since_update:
    displayName: 경과일
views:
  - type: table
    name: 전체 프로젝트
    groupBy:
      property: status
      direction: ASC
    order:
      - formula.status_icon
      - file.name
      - project_id
      - status
      - formula.updated
  - type: table
    name: 진행 중
    filters: status == "active"
    order:
      - file.name
      - project_id
      - formula.days_since_update
      - formula.updated
    sort:
      - property: formula.days_since_update
        direction: DESC
  - type: table
    name: 프로젝트 허브 미갱신 (14일+)
    filters: formula.is_stale == true
    order:
      - file.name
      - project_id
      - formula.days_since_update
      - formula.updated
    sort:
      - property: formula.days_since_update
        direction: DESC

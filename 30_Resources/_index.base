filters:
  and:
    - file.inFolder("30_Resources")
    - file.ext == "md"
    - '!file.name.startsWith("_")'
    - '!file.inFolder("30_Resources/References/Clippings/_local-snapshots")'
formulas:
  updated: file.mtime.relative()
  created_date: if(created, date(created).format("YYYY-MM-DD"), file.ctime.format("YYYY-MM-DD"))
  resource_type: if(file.folder.contains("Books"), "📚 Book", if(file.folder.contains("Articles"), "📰 Article", if(file.folder.contains("Clippings"), "📎 Clipping", if(file.folder.contains("DevLog"), "🔧 DevLog", if(file.folder.contains("Troubleshooting"), "🧯 Troubleshooting", if(file.folder.contains("Tools"), "🛠️ Tools", "📁 기타"))))))
  subfolder: file.folder.replace("30_Resources/", "").replace("References/", "").replace("Development/", "")
  read_status: if(status == "완독", "✅", if(status == "읽는 중", "📖", if(status == "예정", "📋", "-")))
  backlinks: file.backlinks.length
  tier: if(my_rate >= 5, "① S", if(my_rate >= 4, "② A", if(my_rate >= 3, "③ B", if(my_rate >= 2, "④ C", if(my_rate >= 1, "⑤ D", "⑥ 미분류")))))
  stars: if(my_rate, "★".repeat(my_rate.floor()) + if((my_rate - my_rate.floor()) >= 0.5, "½", "") + " " + my_rate, "별점 없음")
  read_period: if(start_read_date, start_read_date.format("YYYY-MM-DD") + " ~ " + if(finish_read_date, finish_read_date.format("YYYY-MM-DD"), "…"), "-")
properties:
  file.name:
    displayName: 노트
  file.mtime:
    displayName: 수정일
  formula.resource_type:
    displayName: 유형
  formula.subfolder:
    displayName: 분류
  author:
    displayName: 저자
  my_rate:
    displayName: 점수
  formula.read_status:
    displayName: 상태
  formula.updated:
    displayName: 수정
  formula.created_date:
    displayName: 생성일
  formula.backlinks:
    displayName: 참조 수
  created:
    displayName: 수집일
  status:
    displayName: 상태
  description:
    displayName: 설명
  formula.tier:
    displayName: Tier
  formula.stars:
    displayName: 별점
  note.book_note:
    displayName: 한줄평
  formula.read_period:
    displayName: 독서 기간
views:
  - type: table
    name: 전체 리소스
    groupBy:
      property: formula.resource_type
      direction: ASC
    order:
      - file.name
      - formula.subfolder
      - author
      - formula.updated
    sort: []
    columnSize:
      formula.subfolder: 101
      note.author: 189
  - type: cards
    name: 📚 도서 목록
    filters:
      and:
        - file.inFolder("30_Resources/References/Books")
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - formula.stars
      - my_rate
      - book_note
      - author
      - formula.read_period
    sort:
      - property: my_rate
        direction: DESC
    columnSize:
      formula.read_status: 56
      note.author: 189
    image: note.cover_url
    imageAspectRatio: 1.3
    imageFit: contain
  - type: table
    name: 🏆 Tier
    filters:
      and:
        - file.inFolder("30_Resources/References/Books")
        - my_rate >= 1
    groupBy:
      property: formula.tier
      direction: ASC
    order:
      - file.name
      - formula.stars
      - my_rate
      - book_note
      - author
    sort:
      - property: my_rate
        direction: DESC
  - type: table
    name: 📖 읽는 중 · 예정
    filters:
      and:
        - file.inFolder("30_Resources/References/Books")
        - or:
            - status == "읽는 중"
            - status == "예정"
    order:
      - file.name
      - author
      - formula.read_status
      - formula.read_period
      - formula.stars
    sort:
      - property: formula.read_period
        direction: DESC
  - type: table
    name: ⭐ 평점 높은 순
    filters:
      and:
        - file.inFolder("30_Resources/References/Books")
    order:
      - file.name
      - author
      - my_rate
      - formula.updated
    sort:
      - property: my_rate
        direction: DESC
    columnSize:
      file.name: 267
      note.author: 210
  - type: table
    name: ⚠️ 도서 메타데이터 점검
    filters:
      and:
        - file.inFolder("30_Resources/References/Books")
        - or:
            - and:
                - status == "완독"
                - "!finish_read_date"
            - and:
                - status == "읽는 중"
                - finish_read_date
    order:
      - file.name
      - status
      - start_read_date
      - finish_read_date
      - my_rate
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: 📎 읽기 대기 Clippings
    filters:
      and:
        - file.inFolder("30_Resources/References/Clippings")
        - status == "unread"
    order:
      - file.name
      - created
      - author
      - description
      - formula.updated
    sort:
      - property: created
        direction: ASC
  - type: table
    name: 🔧 DevLog
    filters:
      and:
        - file.inFolder("30_Resources/Development/DevLog")
    order:
      - file.name
      - projects
      - date
      - formula.updated
    sort:
      - property: date
        direction: DESC
  - type: table
    name: 📰 아티클 & 기타
    filters:
      and:
        - file.inFolder("30_Resources/References")
        - '!file.inFolder("30_Resources/References/Books")'
        - or:
            - file.inFolder("30_Resources/References/Articles")
            - file.inFolder("30_Resources/References/etc")
    order:
      - file.name
      - formula.resource_type
      - formula.updated
    sort:
      - property: file.name
        direction: ASC
      - property: formula.resource_type
        direction: ASC
    columnSize:
      file.name: 375
      formula.resource_type: 189
      formula.updated: 126
  - type: table
    name: 🔗 자주 참조됨
    filters: formula.backlinks >= 2
    order:
      - file.name
      - formula.resource_type
      - formula.backlinks
      - formula.updated
    sort:
      - property: formula.backlinks
        direction: DESC
  - type: table
    name: 최근 수정
    order:
      - file.name
      - formula.resource_type
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
    limit: 15

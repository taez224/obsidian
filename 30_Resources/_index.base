filters:
  and:
    - file.inFolder("30_Resources")
    - file.ext == "md"
    - '!file.name.startsWith("_")'
formulas:
  updated: file.mtime.relative()
  created_date: if(created, date(created).format("YYYY-MM-DD"), file.ctime.format("YYYY-MM-DD"))
  resource_type: if(file.folder.contains("Books"), "📚 Book", if(file.folder.contains("Articles"), "📰 Article", if(file.folder.contains("DevLog"), "🔧 DevLog", if(file.folder.contains("Tools"), "🛠️ Tools", "📁 기타"))))
  subfolder: file.folder.replace("30_Resources/", "").replace("References/", "").replace("Development/", "")
  rating_display: if(my_rate, "⭐".repeat(my_rate), "-")
  read_status: if(status == "완독", "✅", if(status == "읽는 중", "📖", if(status == "예정", "📋", "-")))
  connections: file.links.length + file.backlinks.length
  tier: if(my_rate >= 5, "① S", if(my_rate >= 4, "② A", if(my_rate >= 3, "③ B", if(my_rate >= 2, "④ C", if(my_rate >= 1, "⑤ D", "⑥ 미분류")))))
  stars: if(my_rate, "★".repeat(my_rate.floor()) + if((my_rate - my_rate.floor()) >= 0.5, "½", "") + " " + my_rate, "별점 없음")
  read_period: if(start_read_date, start_read_date.format("YYYY-MM-DD") + " ~ " + if(finish_read_date, finish_read_date.format("YYYY-MM-DD"), "…"), "-")
properties:
  file.name:
    displayName: 노트
  formula.resource_type:
    displayName: 유형
  formula.subfolder:
    displayName: 분류
  author:
    displayName: 저자
  formula.rating_display:
    displayName: 평점
  formula.read_status:
    displayName: 상태
  formula.updated:
    displayName: 수정
  formula.created_date:
    displayName: 생성일
  formula.connections:
    displayName: 연결
  formula.tier:
    displayName: Tier
  formula.stars:
    displayName: 별점
  note.book_note:
    displayName: 한줄평
  formula.read_period:
    displayName: 독서 기간
views:
  - type: table
    name: 전체 리소스
    groupBy:
      property: formula.resource_type
      direction: ASC
    order:
      - file.name
      - formula.subfolder
      - author
      - formula.updated
    sort: []
    columnSize:
      formula.subfolder: 101
      note.author: 189
  - type: cards
    name: 📚 도서 목록
    filters:
      and:
        - file.inFolder("30_Resources/References/Books")
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - formula.stars
      - book_note
      - author
      - formula.read_period
    sort:
      - property: formula.rating_display
        direction: DESC
      - property: formula.read_status
        direction: DESC
    columnSize:
      formula.read_status: 56
      note.author: 189
      formula.rating_display: 82
    image: note.cover_url
    imageAspectRatio: 1.3
    imageFit: contain
  - type: table
    name: 🏆 Tier
    filters:
      and:
        - file.inFolder("30_Resources/References/Books")
        - my_rate >= 1
    groupBy:
      property: formula.tier
      direction: ASC
    order:
      - file.name
      - formula.stars
      - book_note
      - author
    sortBy:
      property: my_rate
      direction: DESC
  - type: table
    name: 📖 읽는 중 · 예정
    filters:
      and:
        - file.inFolder("30_Resources/References/Books")
        - or:
            - status == "읽는 중"
            - status == "예정"
    order:
      - file.name
      - author
      - formula.read_status
      - formula.read_period
      - formula.stars
    sortBy:
      property: start_read_date
      direction: DESC
  - type: table
    name: ⭐ 평점 높은 순
    filters:
      and:
        - file.inFolder("30_Resources/References/Books")
    order:
      - file.name
      - author
      - formula.rating_display
      - formula.updated
    sort:
      - property: formula.rating_display
        direction: DESC
    sortBy:
      property: my_rate
      direction: DESC
    columnSize:
      file.name: 267
      note.author: 210
  - type: table
    name: 🔧 DevLog
    filters:
      and:
        - file.inFolder("30_Resources/Development/DevLog")
    order:
      - file.name
      - file.tags
      - formula.created_date
      - formula.updated
    sortBy:
      property: file.mtime
      direction: DESC
  - type: table
    name: 📰 아티클 & 기타
    filters:
      and:
        - file.inFolder("30_Resources/References")
        - '!file.inFolder("30_Resources/References/Books")'
        - or:
            - file.inFolder("30_Resources/References/Articles")
            - file.inFolder("30_Resources/References/etc")
    order:
      - file.name
      - formula.resource_type
      - formula.updated
    sort:
      - property: file.name
        direction: ASC
      - property: formula.resource_type
        direction: ASC
    columnSize:
      file.name: 375
      formula.resource_type: 189
      formula.updated: 126
  - type: table
    name: 🔗 자주 참조됨
    filters: formula.connections >= 2
    order:
      - file.name
      - formula.resource_type
      - formula.connections
      - formula.updated
    sortBy:
      property: formula.connections
      direction: DESC
  - type: table
    name: 최근 수정
    order:
      - file.name
      - formula.resource_type
      - formula.updated
    limit: 15
    sortBy:
      property: file.mtime
      direction: DESC

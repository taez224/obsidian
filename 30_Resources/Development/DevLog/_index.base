filters:
  and:
    - file.inFolder("30_Resources/Development/DevLog")
    - file.ext == "md"
    - '!file.name.startsWith("_")'
formulas:
  tier: if(file.inFolder("30_Resources/Development/DevLog/daily"), "📅 Daily", if(file.inFolder("30_Resources/Development/DevLog/weekly"), "📆 Weekly", if(file.inFolder("30_Resources/Development/DevLog/monthly"), "🗓 Monthly", "❓ Other")))
  year_month: if(file.basename.length == 7, file.basename, if(file.basename.length == 10, file.basename.slice(0, 7), "-"))
  updated: file.mtime.relative()
properties:
  file.name:
    displayName: 노트
  formula.tier:
    displayName: 계층
  formula.year_month:
    displayName: 연-월
  projects:
    displayName: 프로젝트
  formula.updated:
    displayName: 수정
views:
  - type: table
    name: 📊 3계층 한눈에 (Monthly · Weekly · Daily)
    groupBy:
      property: formula.tier
      direction: ASC
    order:
      - file.name
      - projects
      - formula.updated
    sort:
      - property: file.name
        direction: DESC
  - type: table
    name: 🧭 프로젝트별 기록
    groupBy:
      property: projects
      direction: ASC
    order:
      - file.name
      - formula.tier
      - projects
      - formula.updated
    sort:
      - property: file.name
        direction: DESC
  - type: table
    name: 📅 Daily — 월별 비교 (어느 달이 활발했나)
    filters: file.inFolder("30_Resources/Development/DevLog/daily")
    groupBy:
      property: formula.year_month
      direction: DESC
    order:
      - file.name
      - projects
      - formula.updated
    sort:
      - property: file.name
        direction: DESC
  - type: table
    name: 📆 Weekly
    filters: file.inFolder("30_Resources/Development/DevLog/weekly")
    order:
      - file.name
      - projects
      - formula.updated
    sort:
      - property: file.name
        direction: DESC
  - type: table
    name: 🗓 Monthly
    filters: file.inFolder("30_Resources/Development/DevLog/monthly")
    order:
      - file.name
      - projects
      - formula.updated
    sort:
      - property: file.name
        direction: DESC

filters:
  and:
    - file.ext == "md"
    - '!file.name.startsWith("_")'
    - '!file.inFolder("40_Archive")'
    - '!file.inFolder("99_Templates")'
    - '!file.inFolder(".obsidian")'
    - '!file.inFolder(".smart-env")'
    - '!file.inFolder(".agents")'
    - '!file.inFolder(".claude")'
    - '!file.inFolder(".codex")'
    - '!file.inFolder("_workspace")'
    - '!file.inFolder("30_Resources/References/Clippings/_local-snapshots")'
formulas:
  days_in_inbox: (now() - if(created, date(created), file.ctime)).days.floor()
  days_since_update: (now() - file.mtime).days.floor()
  days_since_created: (now() - if(created, date(created), file.ctime)).days.floor()
  connections: file.links.length + file.backlinks.length
  is_orphan: file.links.length == 0 && file.backlinks.length == 0
  is_stale_project: project_id && status == "active" && (now() - file.mtime).days.floor() >= 14
  is_inbox_overdue: file.inFolder("00_Inbox") && (now() - if(created, date(created), file.ctime)).days.floor() >= 7
  updated: file.mtime.relative()
  created_date: if(created, date(created).format("YYYY-MM-DD"), file.ctime.format("YYYY-MM-DD"))
properties:
  file.name:
    displayName: 노트
  formula.days_in_inbox:
    displayName: 체류일
  formula.days_since_update:
    displayName: 경과일
  formula.days_since_created:
    displayName: 수집 경과일
  formula.connections:
    displayName: 연결
  formula.updated:
    displayName: 수정
  formula.created_date:
    displayName: 생성일
  project_id:
    displayName: 프로젝트 ID
views:
  - type: table
    name: 📥 Inbox 정리 부채 (7일+)
    filters:
      and:
        - file.inFolder("00_Inbox")
        - formula.is_inbox_overdue == true
    order:
      - file.name
      - formula.days_in_inbox
      - formula.created_date
      - formula.updated
    sort:
      - property: formula.days_in_inbox
        direction: DESC
    summaries:
      formula.days_in_inbox: Average
  - type: table
    name: 🪦 고립된 Slipbox
    filters:
      and:
        - file.inFolder("01_Slipbox")
        - formula.is_orphan == true
    order:
      - file.name
      - formula.created_date
      - formula.updated
      - formula.connections
    sort:
      - property: formula.created_date
        direction: ASC
  - type: table
    name: 🟢 프로젝트 허브 미갱신 (14일+)
    filters:
      and:
        - file.inFolder("20_Projects")
        - status == "active"
        - formula.is_stale_project == true
    order:
      - file.name
      - project_id
      - formula.days_since_update
      - formula.updated
    sort:
      - property: formula.days_since_update
        direction: DESC
  - type: table
    name: 📰 오래된 Clippings (30일+)
    filters:
      and:
        - file.inFolder("30_Resources/References/Clippings")
        - status == "unread"
        - formula.days_since_created >= 30
    order:
      - file.name
      - created
      - formula.days_since_created
      - formula.updated
    sort:
      - property: formula.days_since_created
        direction: DESC
    limit: 30
    columnSize:
      file.name: 393

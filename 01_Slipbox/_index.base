filters:
  and:
    - file.inFolder("01_Slipbox")
    - file.ext == "md"
    - '!file.name.startsWith("_")'
formulas:
  connections: file.links.length + file.backlinks.length
  outlinks: file.links.length
  backlinks: file.backlinks.length
  updated: file.mtime.relative()
  days_since_update: (now() - file.mtime).days.floor()
  is_orphan: file.links.length == 0 && file.backlinks.length == 0
  recorded_reuse_count: if(used_in, used_in.length, 0)
properties:
  file.name:
    displayName: 노트
  created:
    displayName: 생성일
  type:
    displayName: 유형
  status:
    displayName: 성숙도
  formula.connections:
    displayName: 전체 연결
  formula.outlinks:
    displayName: 나가는 링크
  formula.backlinks:
    displayName: 백링크
  formula.updated:
    displayName: 최근 수정
  formula.days_since_update:
    displayName: 미갱신일
  formula.recorded_reuse_count:
    displayName: 기록된 재사용
views:
  - type: table
    name: 전체 노트
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - type
      - status
      - formula.recorded_reuse_count
      - formula.updated
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: seedling 검토
    filters:
      and:
        - type == "permanent"
        - status == "seedling"
    order:
      - file.name
      - created
      - formula.recorded_reuse_count
      - formula.days_since_update
      - formula.updated
    sort:
      - property: formula.days_since_update
        direction: DESC
  - type: table
    name: 기록된 재사용이 있는 seedling
    filters:
      and:
        - type == "permanent"
        - status == "seedling"
        - formula.recorded_reuse_count > 0
    order:
      - file.name
      - formula.recorded_reuse_count
      - created
      - formula.updated
    sort:
      - property: formula.recorded_reuse_count
        direction: DESC
    summaries:
      formula.recorded_reuse_count: Sum
  - type: table
    name: 고립된 노트
    filters:
      and:
        - type == "permanent"
        - formula.is_orphan == true
    order:
      - file.name
      - status
      - created
      - formula.updated
  - type: table
    name: MOC
    filters: type == "hub"
    order:
      - file.name
      - status
      - formula.outlinks
      - formula.backlinks
      - formula.updated
    sort:
      - property: formula.outlinks
        direction: DESC
    columnSize:
      file.name: 324
      formula.outlinks: 167
  - type: table
    name: 최근 수정순
    order:
      - file.name
      - formula.updated
      - formula.connections
    sort:
      - property: formula.updated
        direction: DESC
    columnSize:
      file.name: 430
      formula.updated: 89
  - type: table
    name: 연결 현황
    order:
      - file.name
      - type
      - status
      - formula.outlinks
      - formula.backlinks
      - formula.connections
    sort:
      - property: formula.connections
        direction: DESC
    summaries:
      formula.connections: Sum
      formula.outlinks: Sum
      formula.backlinks: Sum
  - type: table
    name: 메타데이터 누락
    filters:
      or:
        - created == null
        - type == null
        - status == null
    order:
      - file.name
      - created
      - type
      - status
  - type: cards
    name: 갤러리
    order:
      - file.name
      - type
      - status
      - formula.recorded_reuse_count
      - formula.updated

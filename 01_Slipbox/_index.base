filters:
  and:
    - file.inFolder("01_Slipbox")
    - file.ext == "md"
    - '!file.name.startsWith("_")'
formulas:
  connections: file.links.length + file.backlinks.length
  outlinks: file.links.length
  backlinks: file.backlinks.length
  updated: file.mtime.relative()
  created_date: file.ctime.format("YYYY-MM-DD")
  word_count: (file.size / 5).round(0)
  is_orphan: file.links.length == 0 && file.backlinks.length == 0
properties:
  file.name:
    displayName: 노트
  file.tags:
    displayName: 태그
  formula.connections:
    displayName: 연결
  formula.outlinks:
    displayName: 링크
  formula.backlinks:
    displayName: 백링크
  formula.updated:
    displayName: 수정
  formula.created_date:
    displayName: 생성일
  formula.word_count:
    displayName: 단어수
views:
  - type: table
    name: 전체 노트
    groupBy:
      property: file.tags
      direction: ASC
    order:
      - file.name
      - formula.connections
      - formula.updated
    summaries:
      formula.connections: Average
  - type: table
    name: 고립된 노트
    filters: formula.is_orphan == true
    order:
      - file.name
      - formula.created_date
      - formula.updated
  - type: table
    name: 허브 노트
    filters: formula.connections >= 3
    order:
      - file.name
      - formula.connections
      - formula.outlinks
      - formula.backlinks
    sortBy:
      property: formula.connections
      direction: DESC
    columnSize:
      file.name: 250
      formula.outlinks: 167
  - type: table
    name: 최근 수정순
    order:
      - file.name
      - formula.updated
      - formula.connections
    sortBy:
      property: file.mtime
      direction: DESC
  - type: table
    name: 연결 분석
    order:
      - file.name
      - formula.outlinks
      - formula.backlinks
      - formula.connections
    summaries:
      formula.connections: Sum
      formula.outlinks: Sum
      formula.backlinks: Sum
  - type: cards
    name: 갤러리
    order:
      - file.name
      - file.tags
      - formula.connections
